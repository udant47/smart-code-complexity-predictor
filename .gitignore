# ---------------------------------------------------------------------------
# SmartCode .gitignore
# Code, tests, docs, screenshots and the small evaluation reports are committed.
# Environments, caches, downloaded datasets, trained models and local output are not.
# ---------------------------------------------------------------------------

# Virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode, caches and tool state
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build / packaging
build/
dist/
*.egg-info/

# Editors / OS
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# Logs and temporary files
*.log
*.tmp
*.bak
tmp/
scratch/

# Secrets and credentials (never commit these)
.env
.env.*
.streamlit/secrets.toml
*.pem
*.key
*.p12
*.pfx
id_rsa*
credentials*.json

# Datasets: downloaded and rebuilt locally (CodeComplex's licence is not stated,
# so its data is never redistributed). Keep the folders.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Dataset statistics only (counts, hashes, versions; no source code), shown on the Dataset tab
!data/processed/dataset_report.json

# Trained models: rebuilt with the training commands. Never download model pickles from untrusted sources.
models/*
!models/.gitkeep
# Exception for deployment (Streamlit Community Cloud cannot train): the files the app loads at runtime.
# They are our own training output, verified by SHA-256 (model_metadata.json) before unpickling.
!models/complexity_model.joblib
!models/preprocessing_pipeline.joblib
!models/model_metadata.json
!models/explainability.json
!models/preprocessing_config.json
!models/tuning_results.json

# Local output of `python -m src.repository` (contains absolute local paths)
reports/repository/
